# Copy this file to .env and fill in real values. Never commit .env.

# Optional: Groq API key for LLM-polished acknowledgment replies.
# If unset, the system falls back to Ollama (if running locally) or
# the plain template reply. Routing (domain/priority) NEVER uses the LLM.
GROQ_API_KEY=

# Must be a model that actually exists on your Groq account.
# On first run with a real key, llm.py will list available models
# and you should pick one from that list (do not assume a model name).
GROQ_MODEL=openai/gpt-oss-20b

# Optional local fallback if no Groq key is present.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Optional: Postgres connection string (e.g. a free Neon or Supabase
# database). If unset, nagrikmitra/store.py uses a local SQLite file at
# data/nagrikmitra.db instead — no setup needed for local dev/tests. Set
# this in production so tickets/accounts survive redeploys.
# Example (Neon): postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# --- Auth (nagrikmitra/auth.py) ---

# Session cookies. If unset, a secret is generated and persisted to
# data/.session_secret (gitignored) on first run, so cookies survive
# restarts without extra setup. Set this explicitly for anything beyond
# local dev/demo use.
SESSION_SECRET=

# Officer self-registration requires this shared code. Registering as an
# officer is rejected outright if this is unset — never silently open.
# Pick your own value; never commit a real one.
OFFICER_SIGNUP_CODE=

# Optional: "Sign in with Google" for citizens/officers. Create an OAuth
# client at https://console.cloud.google.com/apis/credentials (type "Web
# application", authorized redirect URI = GOOGLE_REDIRECT_URI below). If
# unset, Google login is simply hidden — email/username+password still
# works fully without it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
