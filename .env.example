# Copy this file to .env and fill in real values. Never commit .env.

# Optional: Groq API key for LLM-polished acknowledgment replies.
# If unset, the system falls back to Ollama (if running locally) or
# the plain template reply. Routing (domain/priority) NEVER uses the LLM.
GROQ_API_KEY=

# Must be a model that actually exists on your Groq account.
# On first run with a real key, llm.py will list available models
# and you should pick one from that list (do not assume a model name).
GROQ_MODEL=openai/gpt-oss-20b

# Optional local fallback if no Groq key is present.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
